@{
    ViewData["Title"] = "Supervisor Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        /* INLINE MINIMAL CSS FOR INITIAL RENDER */
        :root {
            --primary-blue: #1e3c72;
            --secondary-blue: #2a5298;
            --accent-gold: #ffc107;
            --light-blue: #e8f4fd;
            --white: #ffffff;
            --gray-light: #f5f5f5;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            background: #f8f9fa;
        }

        .dashboard-container {
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .dashboard-header {
            background: var(--primary-blue);
            color: white;
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .logo-small {
            width: 40px;
            height: 40px;
        }

            .logo-small img {
                width: 100%;
                height: 100%;
                object-fit: contain;
                border-radius: 6px;
            }

        .header-title h1 {
            font-size: 1.6rem;
            font-weight: 700;
            margin: 0;
        }

        .btn-logout {
            background: white;
            color: var(--primary-blue);
            border: none;
            padding: 10px 25px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .dashboard-main {
            flex: 1;
            padding: 20px 40px;
            overflow-y: auto;
        }

        .step-content-area {
            background: white;
            border-radius: 15px;
            padding: 30px;
            margin-top: 20px;
        }

        .step-content {
            display: none;
        }

            .step-content.active {
                display: block;
            }
    </style>

    <!-- EXTERNAL CSS -->
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="dashboard-container">
        <!-- HEADER -->
        <header class="dashboard-header">
            <div class="header-left">
                <div class="logo-small">
                    <img src="~/Image/Nagpur_University_logo.jpg" alt="RTMNU Logo"
                         onerror="this.onerror=null; this.src='data:image/svg+xml;base64,';">
                </div>
                <div class="header-title">
                    <h1>Supervisor Dashboard</h1>
                </div>
            </div>

            <button class="btn-logout" onclick="logout()">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </header>

        <!-- MAIN CONTENT -->
        <main class="dashboard-main">
            <div class="step-indicator">
                <p class="step-info">
                    <i class="bi bi-info-circle"></i> Fill all form fields to go to next step
                </p>
            </div>

            <!-- STEPPER -->
            <div class="stepper-container">
                <div class="stepper">
                    <div class="step active" onclick="showStep('A')">A</div>
                    <div class="line active"></div>

                    <div class="step" onclick="showStep('B')">B</div>
                    <div class="line"></div>

                    <div class="step" onclick="showStep('C')">C</div>
                    <div class="line"></div>

                    <div class="step" onclick="showStep('D')">D</div>
                    <div class="line"></div>

                    <div class="step" onclick="showStep('E')">E</div>
                    <div class="line"></div>

                    <div class="step" onclick="showStep('F')">F</div>
                    <div class="line"></div>

                    <div class="step" onclick="showStep('G')">G</div>
                    <div class="line"></div>

                    <div class="step" onclick="showStep('H')">H</div>
                </div>
            </div>

            <!-- STEP CONTENT AREA -->
            <div class="step-content-area">
                <!-- Step A Content - Personal Details -->
                <div class="step-content active" id="stepA">
                    <div class="content-header">
                        <h2><i class="bi bi-person-lines-fill"></i> A. Personal Details</h2>
                        <p>Complete your personal information</p>
                    </div>

                    <div class="user-basic-info">
                        <div class="info-card">
                            <h3><i class="bi bi-person-badge"></i> Basic Information</h3>
                            <div class="info-grid">
                                <div class="info-item">
                                    <label>Email ID:</label>
                                    <div class="info-value" id="sessionEmail">@Context.Session.GetString("Email")</div>
                                </div>
                                <div class="info-item">
                                    <label>Aadhar Number:</label>
                                    <div class="info-value" id="sessionAadhar">@Context.Session.GetString("Aadhar")</div>
                                </div>
                                <div class="info-item">
                                    <label>Mobile Number:</label>
                                    <div class="info-value" id="sessionMobile">@Context.Session.GetString("Mobile")</div>
                                </div>
                                <div class="info-item">
                                    <label>Full Name:</label>
                                    <div class="info-value" id="sessionFullName">@Context.Session.GetString("FullName")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="personal-form">
                        <form id="personalDetailsForm">
                            <!-- IMAGE UPLOAD SECTION -->
                            <div class="form-section">
                                <h3><i class="bi bi-image"></i> Photograph Upload</h3>

                                <div class="image-upload-container">
                                    <div class="image-preview" id="imagePreview">
                                        <i class="bi bi-person-circle"></i>
                                        <p>No image selected</p>
                                    </div>

                                    <div class="upload-controls">
                                        <input type="file" id="photoUpload" accept="image/*" class="file-input"
                                               style="display: none;" onchange="previewImage(event)">
                                        <button type="button" class="btn btn-upload" onclick="document.getElementById('photoUpload').click()">
                                            <i class="bi bi-upload"></i> Upload Photo
                                        </button>
                                        <button type="button" class="btn btn-secondary" onclick="removeImage()">
                                            <i class="bi bi-trash"></i> Remove
                                        </button>
                                    </div>

                                    <div class="upload-instructions">
                                        <p><i class="bi bi-info-circle"></i> Requirements:</p>
                                        <ul>
                                            <li>Recent passport size photograph</li>
                                            <li>Max file size: 2MB</li>
                                            <li>Formats: JPG, PNG, JPEG</li>
                                            <li>White background preferred</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <!-- Section 1: Name in Full (Block Letters) -->
                            <div class="form-section">
                                <h3><i class="bi bi-card-heading"></i> 1. Name in Full (In Block Letters)</h3>

                                <div class="name-table-container">
                                    <table class="name-table">
                                        <thead>
                                            <tr>
                                                <th>Surname</th>
                                                <th>Middle Name</th>
                                                <th>First Name</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td><input type="text" id="surname" class="form-control" required></td>
                                                <td><input type="text" id="middleName" class="form-control"></td>
                                                <td><input type="text" id="firstName" class="form-control" required></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                <@* div class="form-row">
                                    <div class="form-col full-width">
                                        <label for="nameInWords">(In words)</label>
                                        <input type="text" id="nameInWords" class="form-control" placeholder="Enter name in words">
                                    </div>
                                </div> *@
                            </div>

                            <!-- Section 2: Father/Husband Name -->
                            <div class="form-section">
                                <h3><i class="bi bi-people-fill"></i> 2. Name of Father/Husband</h3>

                                <div class="form-row">
                                    <div class="form-col">
                                        <label for="fatherHusbandName">Father/Husband Name *</label>
                                        <input type="text" id="fatherHusbandName" class="form-control" required>
                                    </div>
                                </div>
                            </div>

                            <!-- Section 3: Date of Birth -->
                            <div class="form-section">
                                <h3><i class="bi bi-calendar"></i> 3. Date of Birth</h3>

                                <div class="form-row">
                                    <div class="form-col">
                                        <label for="dateOfBirth">Date of Birth *</label>
                                        <input type="date" id="dateOfBirth" class="form-control" required>
                                    </div>
                                </div>
                            </div>

                            <!-- Section 4: Address Details -->
                            <div class="form-section">
                                <h3><i class="bi bi-geo-alt"></i> 4. Address Details</h3>

                                <div class="form-row">
                                    <div class="form-col">
                                        <label for="permanentAddress">(4) Permanent Address *</label>
                                        <textarea id="permanentAddress" class="form-control" rows="3" required></textarea>
                                    </div>
                                </div>

                                <div class="form-row">
                                    <div class="form-col">
                                        <label for="correspondenceAddress">(5) Address for Correspondence *</label>
                                        <textarea id="correspondenceAddress" class="form-control" rows="3" required></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Section 5: Personal Information -->
                            <div class="form-section">
                                <h3><i class="bi bi-person-badge"></i> 5. Personal Information</h3>

                                 <div class="form-row">
                                <div class="form-col">
                              <label for="maritalStatus">(6) Marital Status *</label>
                             <select id="maritalStatus" name="maritalStatus" class="form-control" required>
                                    <option value="">Select Marital Status</option>
                                     <option value="Married">Married</option>
                                     <option value="Single">Single</option>
                            </select>
                            </div>

                                           <div class="form-col">
                                      <label for="religion">(7) Religion *</label>
                                     <input type="text" id="religion" class="form-control" required>
                                </div>
                              </div>
                                <<div class="form-row">
                                    <div class="form-col">
                                        <label for="nationality">(8) Nationality *</label>
                                        <select id="nationality" name="nationality" class="form-control" required>
                                            <option value="">Select Nationality</option>
                                            <option value="Indian" selected>Indian</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>

                                    <div class="form-col">
                                        <label for="caste">(9) Caste *</label>
                                        <input type="text" id="caste" class="form-control" required>
                                    </div>
                                </div>
                            </div>

                            <!-- Section 6: Backward Class Details -->
                            <div class="form-section">
                                <h3><i class="bi bi-person-check"></i> 6. Backward Class Details</h3>

                                <div class="form-group">
                                    <h4>(10)(a) Whether belong to backward class:</h4>
                                    <div class="radio-group">
                                        <label class="radio-option">
                                            <input type="radio" name="backwardClass" value="Yes"> Yes
                                        </label>
                                        <label class="radio-option">
                                            <input type="radio" name="backwardClass" value="No"> No
                                        </label>
                                    </div>
                                </div>

                                <div class="form-group" id="categoryField" style="display: none;">
                                    <h4>(10)(b) If yes, specify category:</h4>
                                    <div class="form-row">
                                        <div class="form-col">
                                            <select id="category" class="form-control">
                                                <option value="">Select Category</option>
                                                <option value="SC">SC</option>
                                                <option value="ST">ST</option>
                                                <option value="OBC">OBC</option>
                                                <option value="VJ">VJ</option>
                                                <option value="NT">NT</option>
                                                <option value="SBC">SBC</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Section 7: Language Details -->
                            <div class="form-section">
                                <h3><i class="bi bi-translate"></i> 7. Language Details</h3>

                                <div class="form-row">
                                    <div class="form-col">
                                        <label for="motherTongue">(11) Mother Tongue *</label>
                                        <select id="motherTongue" name="motherTongue" class="form-control" required>
                                            <option value="">Select Mother Tongue</option>
                                            <option value="Hindi">Hindi</option>
                                            <option value="Marathi">Marathi</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>

                                    <div class="form-col">
                                        <label for="languagesKnown">(12) Languages Known *</label>
                                        <input type="text" id="languagesKnown" class="form-control"
                                               placeholder="e.g., Hindi, English, Marathi" required>
                                    </div>
                                </div>
                            </div>

                            <!-- Form Actions -->
                            <div class="form-actions">
                                <button type="button" class="btn btn-secondary" onclick="clearForm()">
                                    <i class="bi bi-eraser"></i> Clear All
                                </button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle"></i> Save & Next (Step B)
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

              
                <!-- Step B Content -->
                <div class="step-content active" id="stepB">
                    <div class="content-header">
                        <h2><i class="bi bi-file-text"></i> B. Details of Examinations Passed</h2>
                        <p>Fill your educational qualification details</p>
                    </div>

                    <div class="education-form">
                        <form id="educationDetailsForm">
                            <!-- Exam Table -->
                            <div class="form-section">
                                <h3><i class="bi bi-mortarboard"></i> Examination Details</h3>

                                <div class="table-responsive">
                                    <table class="exam-table">
                                        <thead>
                                            <tr>
                                                <th>Name of the Examination</th>
                                                <th>Board / University</th>
                                                <th>Year of Passing</th>
                                                <th>Name of the Institute</th>
                                                <th>Division</th>
                                                <th>Marks Type</th>
                                                <th>Marks/CGPA Obtained</th>
                                                <th>Total Marks/CGPA</th>
                                                <th>Percentage/CGPA</th>
                                            </tr>
                                        </thead>
                                        <tbody id="examRows">
                                            <!-- 10th Standard Row -->
                                            <tr class="exam-row" data-exam="10th">
                                                <td>
                                                    <div class="form-control exam-name-static">10th Standard or equivalent *</div>
                                                </td>
                                                <td>
                                                    <select class="form-control board-university" required>
                                                        <option value="">Select Board</option>
                                                        <option value="MSBSHSE">Maharashtra State Board of Secondary & Higher Secondary Education (MSBSHSE)</option>
                                                        <option value="CBSE">Central Board of Secondary Education (CBSE)</option>
                                                        <option value="CISCE">Council for the Indian School Certificate Examinations (CISCE - ICSE/ISC)</option>
                                                        <option value="NIOS">National Institute of Open Schooling (NIOS)</option>
                                                        <option value="IB">International Baccalaureate (IB)</option>
                                                        <option value="CAIE">Cambridge Assessment International Education (CAIE)</option>
                                                        <option value="Other">Others</option>
                                                    </select>
                                                    <div class="other-board-container" style="display: none; margin-top: 5px;">
                                                        <input type="text" class="form-control other-board" placeholder="Specify other board">
                                                    </div>
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control passing-year" min="1950" max="2024" placeholder="YYYY" required>
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control institute-name" placeholder="School name" required>
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control division" placeholder="e.g., First" required>
                                                </td>
                                                <td>
                                                    <select class="form-control marks-type" required>
                                                        <option value="">Select Type</option>
                                                        <option value="Percentage">Percentage</option>
                                                        <option value="CGPA">CGPA</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control obtained-marks" step="0.01" min="0" placeholder="Obtained" required>
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control total-marks" step="0.01" min="0" placeholder="Total" required>
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control percentage" readonly placeholder="Auto calculated">
                                                </td>
                                            </tr>

                                            <!-- 12th Standard Row -->
                                            <tr class="exam-row" data-exam="12th">
                                                <td>
                                                    <div class="form-control exam-name-static">12th Standard or equivalent *</div>
                                                </td>
                                                <td>
                                                    <select class="form-control board-university" required>
                                                        <option value="">Select Board</option>
                                                        <option value="MSBSHSE">Maharashtra State Board of Secondary & Higher Secondary Education (MSBSHSE)</option>
                                                        <option value="CBSE">Central Board of Secondary Education (CBSE)</option>
                                                        <option value="CISCE">Council for the Indian School Certificate Examinations (CISCE - ICSE/ISC)</option>
                                                        <option value="NIOS">National Institute of Open Schooling (NIOS)</option>
                                                        <option value="IB">International Baccalaureate (IB)</option>
                                                        <option value="CAIE">Cambridge Assessment International Education (CAIE)</option>
                                                        <option value="Other">Others</option>
                                                    </select>
                                                    <div class="other-board-container" style="display: none; margin-top: 5px;">
                                                        <input type="text" class="form-control other-board" placeholder="Specify other board">
                                                    </div>
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control passing-year" min="1950" max="2024" placeholder="YYYY" required>
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control institute-name" placeholder="School/College name" required>
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control division" placeholder="e.g., First" required>
                                                </td>
                                                <td>
                                                    <select class="form-control marks-type" required>
                                                        <option value="">Select Type</option>
                                                        <option value="Percentage">Percentage</option>
                                                        <option value="CGPA">CGPA</option>
                                                    </select>
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control obtained-marks" step="0.01" min="0" placeholder="Obtained" required>
                                                </td>
                                                <td>
                                                    <input type="number" class="form-control total-marks" step="0.01" min="0" placeholder="Total" required>
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control percentage" readonly placeholder="Auto calculated">
                                                </td>
                                            </tr>

                                            <!-- Undergraduate Row -->
                                            <tr class="exam-row" data-exam="UG">
                                                <td>
                                                    <select class="form-control exam-name" required>
                                                        <option value="">Select undergraduate</option>
                                                        <option value="B.Tech/B.E.">B.Tech/B.E.</option>
                                                        <option value="B.Sc.">B.Sc.</option>
                                                        <option value="B.Com.">B.Com.</option>
                                                        <option value="B.A.">B.A.</option>
                                                        <option value="BBA">BBA</option>
                                                        <option value="MBBS">MBBS</option>
                                                        <option value="B.Pharm">B.Pharm</option>
                                                        <option value="LLB">LLB</option>
                                                        <option value="Other">Other</option>
                                                    </select>
                                                    <div class="other-exam-container" style="display: none; margin-top: 5px;">
                                                        <input type="text" class="form-control other-exam" placeholder="Specify other degree">
                                                    </div>
                                                </td>
                                                <td>
                                                    <select class="form-control board-university" required>
                                                        <option value="" disabled selected>Select University</option>
                                                        <option value="Mahatma Gandhi Antarrashtriya Hindi Vishwavidyalaya, Wardha">Mahatma Gandhi Antarrashtriya Hindi Vishwavidyalaya, Wardha</option>
                                                        <option value="University of Mumbai">University of Mumbai</option>
                                                        <option value="Savitribai Phule Pune University">Savitribai Phule Pune University</option>
                                                        <option value="Rashtrasant Tukadoji Maharaj Nagpur University">Rashtrasant Tukadoji Maharaj Nagpur University</option>
                                                        <option value="Dr. Babasaheb Ambedkar Marathwada University">Dr. Babasaheb Ambedkar Marathwada University</option>
                                                        <option value="Shivaji University, Kolhapur">Shivaji University, Kolhapur</option>
                                                        <option value="Sant Gadge Baba Amravati University">Sant Gadge Baba Amravati University</option>
                                                        <option value="Kavayitri Bahinabai Chaudhari North Maharashtra University">Kavayitri Bahinabai Chaudhari North Maharashtra University</option>
                                                        <option value="Swami Ramanand Teerth Marathwada University">Swami Ramanand Teerth Marathwada University</option>
                                                        <option value="Punyashlok Ahilyadevi Holkar Solapur University">Punyashlok Ahilyadevi Holkar Solapur University</option>
                                                        <option value="Gondwana University, Gadchiroli">Gondwana University, Gadchiroli</option>
                                                        <option value="SNDT Women's University">SNDT Women's University</option>
                                                        <option value="Dr. Babasaheb Ambedkar Technological University">Dr. Babasaheb Ammedkar Technological University</option>
                                                        <option value="COEP Technological University">COEP Technological University</option>
                                                        <option value="Maharashtra University of Health Sciences">Maharashtra University of Health Sciences</option>
                                                        <option value="Maharashtra Animal & Fishery Sciences University">Maharashtra Animal & Fishery Sciences University</option>
                                                        <option value="Maharashtra State Skills University">Maharashtra State Skills University</option>
                                                        <option value="Maharashtra International Sports University">Maharashtra International Sports University</option>
                                                        <option value="Kavi Kulaguru Kalidas Sanskrit University">Kavi Kulaguru Kalidas Sanskrit University</option>
                                                        <option value="Mahatma Phule Krishi Vidyapeeth">Mahatma Phule Krishi Vidyapeeth</option>
                                                        <option value="Dr. Panjabrao Deshmukh Krishi Vidyapeeth">Dr. Panjabrao Deshmukh Krishi Vidyapeeth</option>
                                                        <option value="Dr. Balasaheb Sawant Konkan Krishi Vidyapeeth">Dr. Balasaheb Sawant Konkan Krishi Vidyapeeth</option>
                                                        <option value="Vasantrao Naik Marathwada Krishi Vidyapeeth">Vasantrao Naik Marathwada Krishi Vidyapeeth</option>
                                                        <option value="Maharashtra National Law University, Mumbai">Maharashtra National Law University, Mumbai</option>
                                                        <option value="Maharashtra National Law University, Nagpur">Maharashtra National Law University, Nagpur</option>
                                                        <option value="Maharashtra National Law University, Aurangabad">Maharashtra National Law University, Aurangabad</option>
                                                        <option value="Tata Institute of Social Sciences">Tata Institute of Social Sciences</option>
                                                        <option value="Tata Institute of Fundamental Research">Tata Institute of Fundamental Research</option>
                                                        <option value="Homi Bhabha National Institute">Homi Bhabha National Institute</option>
                                                        <option value="Bharati Vidyapeeth">Bharati Vidyapeeth</option>
                                                        <option value="Datta Meghe Institute of Medical Sciences">Datta Meghe Institute of Medical Sciences</option>
                                                        <option value="Gokhale Institute of Politics and Economics">Gokhale Institute of Politics and Economics</option>
                                                        <option value="Indira Gandhi Institute of Development Research">Indira Gandhi Institute of Development Research</option>
                                                        <option value="Defence Institute of Advanced Technology">Defence Institute of Advanced Technology</option>
                                                        <option value="Central Institute of Fisheries Education">Central Institute of Fisheries Education</option>
                                                        <option value="Deccan College Post-Graduate & Research Institute">Deccan College Post-Graduate & Research Institute</option>
                                                        <option value="Amity University, Mumbai">Amity University, Mumbai</option>
                                                        <option value="Ajeenkya D Y Patil University">Ajeenkya D Y Patil University</option>
                                                        <option value="ATLAS SkillTech University">ATLAS SkillTech University</option>
                                                        <option value="MIT World Peace University">MIT World Peace University</option>
                                                        <option value="Sandip University">Sandip University</option>
                                                        <option value="Sanjay Ghodawat University">Sanjay Ghodawat University</option>
                                                        <option value="Somaiya Vidyavihar University">Somaiya Vidyavihar University</option>
                                                        <option value="Vishwakarma University">Vishwakarma University</option>
                                                        <option value="Vijaybhoomi University">Vijaybhoomi University</option>
